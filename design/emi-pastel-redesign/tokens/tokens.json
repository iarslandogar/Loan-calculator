{
  "name": "Loan EMI Calculator — Soft ledger (pastel)",
  "note": "Tested token names are listed under 'tested'. Added tokens are optional helpers used by styles/app.css.",
  "color": {
    "light": {
      "tested": {
        "--bg": "#F6F3FB",
        "--surface": "#FFFFFF",
        "--text": "#2A2540",
        "--text-muted": "#5C5672",
        "--primary": "#CBB9F6",
        "--on-primary": "#2A2540",
        "--error": "#A8324B",
        "--border": "#E6E0F1",
        "--input-border": "#867E9E",
        "--focus": "#6A50D3"
      },
      "added": {
        "--mint": "#D6F2E5",
        "--peach": "#FFE4D1",
        "--butter": "#FFF2C9",
        "--rose": "#F8D5DF",
        "--wash": "#EFEAFB",
        "--band": "#FAF8FE"
      }
    },
    "dark": {
      "tested": {
        "--bg": "#16141E",
        "--surface": "#201D2B",
        "--text": "#EEEAF8",
        "--text-muted": "#B4ADC9",
        "--primary": "#C9B8F6",
        "--on-primary": "#16141E",
        "--error": "#FF9DB2",
        "--border": "#332E43",
        "--input-border": "#7F7699",
        "--focus": "#C9B8F6"
      },
      "added": {
        "--mint": "#1E3A30",
        "--peach": "#3D2B22",
        "--butter": "#36311D",
        "--rose": "#3D2230",
        "--wash": "#2A2638",
        "--band": "#24212F"
      }
    }
  },
  "contrastRules": [
    { "fg": "--text", "bg": ["--bg", "--surface"], "min": 4.5 },
    { "fg": "--text-muted", "bg": ["--bg", "--surface"], "min": 4.5 },
    { "fg": "--error", "bg": ["--bg", "--surface", "--rose"], "min": 4.5 },
    { "fg": "--on-primary", "bg": ["--primary"], "min": 4.5 },
    { "fg": "--input-border", "bg": ["--bg", "--surface"], "min": 3 },
    { "fg": "--focus", "bg": ["--bg", "--surface"], "min": 3 },
    { "fg": "--text", "bg": ["--mint", "--peach", "--butter", "--rose", "--wash", "--band"], "min": 4.5 },
    { "fg": "--text-muted", "bg": ["--mint", "--wash", "--band"], "min": 4.5 }
  ],
  "type": {
    "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "scale": {
      "hero-figure": "clamp(30px, 1rem + 3.2vw, 48px) / 1.05 / 800 / -0.03em, tabular-nums",
      "title": "30px / 1.15 / 780 / -0.025em (24px phone)",
      "card-heading": "20px / 750 (schedule heading 18px)",
      "figure": "22px / 1.2 / 720, tabular-nums (21px phone)",
      "body": "16px / 1.5 / 400",
      "label": "14px / 650",
      "table": "14px tabular-nums; header 12px / 700 / uppercase / +0.06em",
      "figure-label": "12px / 700 / uppercase / +0.08em",
      "hint": "13px / 1.4"
    }
  },
  "space": [4, 8, 12, 16, 20, 24, 28, 40],
  "radius": { "card": 28, "card-phone": 22, "tile": 20, "input": 14, "dialog": 26, "button": 999 },
  "border": { "decorative": "1px var(--border)", "control": "1.5px var(--input-border)", "invalid": "2px var(--error)" },
  "focus": "outline: 3px solid var(--focus); outline-offset: 3px",
  "controlMinHeight": 48,
  "breakpoints": { "twoColumn": "min-width: 769px", "phone": "max-width: 560px", "zoom200": "max-width: 300px" }
}
